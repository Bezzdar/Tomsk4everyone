# Backend can be run directly for development. The production Docker stack
# receives the same values from tomsk-db/.env.
APP_ENV=development
SECRET_KEY=replace-with-random-secret
JWT_SECRET_KEY=replace-with-independent-random-secret
JWT_EXPIRES_HOURS=24

DB_HOST=localhost
DB_PORT=5432
DB_NAME=tomsk
DB_USER=tomsk_app
DB_PASSWORD=replace-with-database-password
DB_CONNECT_TIMEOUT=5

# Empty is appropriate for the same-origin nginx deployment.
# For local development, list explicit origins separated by commas.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

PORT=5000
UPLOAD_FOLDER=/var/www/tomsk/uploads
MAX_CONTENT_LENGTH=10485760
