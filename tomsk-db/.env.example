APP_ENV=production
HTTP_PORT=80
DB_NAME=tomsk

# Generate independent random values before deployment.
POSTGRES_PASSWORD=replace-with-postgres-admin-password
DB_PASSWORD=replace-with-application-database-password
SECRET_KEY=replace-with-random-flask-secret
JWT_SECRET_KEY=replace-with-independent-jwt-secret
JWT_EXPIRES_HOURS=24
MAX_CONTENT_LENGTH=10485760

# Same-origin deployment needs no CORS origins.
CORS_ORIGINS=

# Only used when starting the optional `admin` profile.
PGADMIN_EMAIL=admin@example.test
PGADMIN_PASSWORD=replace-with-pgadmin-password
